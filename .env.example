# SolarCast AI - Environment Configuration
# ==========================================

# Database (PostgreSQL for production, SQLite for development)
DATABASE_URL=sqlite:///./solarcast.db
# DATABASE_URL=postgresql://solarcast:solarcast_pass@localhost:5432/solarcast_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ML Model Configuration
MODEL_ARTIFACTS_DIR=ml/artifacts
DEFAULT_MODEL=gradient_boosting

# Frontend
REACT_APP_API_URL=http://localhost:8000

# Monitoring
ENABLE_MONITORING=true

# Logging
LOG_LEVEL=INFO
